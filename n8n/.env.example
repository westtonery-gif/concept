# Copy to .env and fill in — .env is git-ignored (repo .gitignore).

# Absolute path to n8n's data directory (SQLite DB, credentials, workflows).
# Point this at the existing ~/.n8n to keep what npx n8n already created.
N8N_DATA_DIR=/absolute/path/to/.n8n

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Only needed once n8n is reachable from outside localhost (see README "Moving to a domain").
WEBHOOK_URL=
GENERIC_TIMEZONE=UTC
